[Unit]
Description=Astrisk Cloudflare Tunnel
Wants=network-online.target panchang.service
After=network-online.target panchang.service
# Keep retrying after an extended mobile-hotspot outage instead of rate-limiting
# restarts after several consecutive failed connection attempts.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/panchang
# Mobile carriers may aggressively expire idle UDP/QUIC flows.  HTTP/2 keeps
# the outbound tunnel on TCP/TLS while preserving Cloudflare Tunnel security.
ExecStart=%h/panchang/.runtime/cloudflared/cloudflared --no-autoupdate tunnel --protocol http2 --config %h/panchang/.runtime/cloudflared/config.yml run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
