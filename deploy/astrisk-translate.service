[Unit]
Description=Astrisk local translation model (IndicTrans2, loopback only)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/panchang
Environment=PYTHONPATH=%h/panchang/.runtime/translate-deps
Environment=HF_HUB_OFFLINE=1
Environment=TRANSLATE_THREADS=2
ExecStart=/usr/bin/python3 %h/panchang/scripts/translate-server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=1500M

[Install]
WantedBy=default.target
