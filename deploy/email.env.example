# Install values in a mode-600 file outside Git and add EnvironmentFile= to
# the panchang.service user override. No delivery is enabled with missing values.
PUBLIC_ORIGIN=https://astrisk.space
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS with certificate validation is mandatory. Use a provider app password,
# never the password for your personal webmail login.
